APP_NAME=SeptiGuard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.septiguard.tech
FRONTEND_URL=https://septiguard.tech
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=septiguard
DB_USERNAME=septiguard
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=septiguard
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

PREDICTION_SERVICE_URL=http://prediction:8000
PREDICTION_SERVICE_API_KEY=
