SENSOR_API_KEY=
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=septiguard-test-aggin
MQTT_TOPIC=septiguard-test-aggin/tanks/+/readings
MQTT_TLS=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=SeptiGuard

FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
